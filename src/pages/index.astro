---
// Language entry point: Arabic is the default (everyone lands on /ar/); English browsers are sent to /en/. Both links stay crawlable.
import { HOMET, META } from '../data/site.js';
// Share preview for the bare domain "/" (crawlers do not run the redirect script): Arabic is the default, same as the canonical.
const ogImg = Astro.site + 'og/ar/home.jpg', ogTitle = HOMET.title.ar, ogDesc = HOMET.desc.ar;
---
<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8" /><title>مقاول الرياض · ترميم فلل وبناء ملاحق وتوسعة</title>
<meta property="og:type" content="website" /><meta property="og:title" content={ogTitle} /><meta property="og:description" content={ogDesc} /><meta property="og:url" content={Astro.site + 'ar/'} />
<meta property="og:image" content={ogImg} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={ogTitle} />
<meta property="og:site_name" content={META.ar.name} /><meta property="og:locale" content={META.ar.locale} /><meta property="og:locale:alternate" content={META.en.locale} />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={ogTitle} /><meta name="twitter:description" content={ogDesc} /><meta name="twitter:image" content={ogImg} />
<meta name="viewport" content="width=device-width, initial-scale=1" /><meta http-equiv="refresh" content="0; url=/ar/" />
<link rel="canonical" href={Astro.site + 'ar/'} /><link rel="alternate" hreflang="en" href={Astro.site + 'en/'} /><link rel="alternate" hreflang="ar" href={Astro.site + 'ar/'} /><link rel="alternate" hreflang="x-default" href={Astro.site + 'ar/'} />
<script is:inline>if(/^en/i.test(navigator.language||''))location.replace('/en/')</script></head>
<body><p><a href="/en/">English</a> · <a href="/ar/">العربية</a></p></body></html>
