---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { META, LANGS, CONTACT, SOCIAL, UI, WA_PATH } from '../data/site.js';
import { LOGO } from '../data/logo.js';
import { href } from '../lib/views.js';
import { splashHtml } from '../lib/splash.js';
interface Props { lang: 'en' | 'ar'; id: string; title: string; description: string; noindex?: boolean; crumbs?: [string, string][] }
const { lang, id, title, description, noindex = false, crumbs = [] } = Astro.props;
const m = META[lang], site = Astro.site!.origin, home = id === 'home';
const url = site + href(lang, id), full = home ? title : `${title} — ${m.name}`;
// Share image: generated by `npm run og` into public/og/<lang>/<id with / → ->.jpg (1200x630).
const ogImg = `${site}/og/${lang}/${noindex ? 'home' : id.replace(/\//g, '-')}.jpg`;
const same = SOCIAL.filter((s) => s.url).map((s) => s.url);
const lg = LOGO[lang], bar = `<rect class="lg-g" x="${lg.barX}" y="${LOGO.barTop}" width="${LOGO.barW}" height="${LOGO.barH}"/>`;
const sprite = `<symbol id="lg" viewBox="0 0 ${lg.w} ${lg.h}"><path fill="currentColor" d="${lg.word}"/>${bar}<g transform="translate(${lg.markX} 0)"><path fill="currentColor" d="${LOGO.mark.navy}"/><path class="lg-g" d="${LOGO.mark.gold}"/></g></symbol>`;
const font = lang === 'ar'
  ? 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&display=swap';
const ld = { '@context': 'https://schema.org', '@type': 'GeneralContractor', name: m.name, url: site + '/' + lang + '/', logo: site + '/brand/mark-512.png', image: site + '/brand/mark-512.png', telephone: CONTACT.tel, email: CONTACT.email, areaServed: { '@type': 'City', name: lang === 'ar' ? 'الرياض' : 'Riyadh' }, ...(same.length ? { sameAs: same } : {}), address: { '@type': 'PostalAddress', addressLocality: lang === 'ar' ? 'الرياض' : 'Riyadh', addressCountry: 'SA' } };
const bc = crumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [[UI.home[lang], href(lang)], ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c[0], item: site + c[1] })) } : null;
---
<!doctype html>
<html lang={lang} dir={m.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <Fragment>
    <link rel="canonical" href={url} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={site + href(l, id)} />)}
    <link rel="alternate" hreflang="x-default" href={site + href('ar', id)} />
    </Fragment>}
    <meta property="og:type" content="website" /><meta property="og:title" content={full} /><meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={url} />}
    <meta property="og:image" content={ogImg} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={full} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImg} /><meta property="og:site_name" content={m.name} /><meta property="og:locale" content={m.locale} />
    <meta property="og:locale:alternate" content={META[lang === 'ar' ? 'en' : 'ar'].locale} />
    <meta name="color-scheme" content="light dark" />
    <!-- App bar (browser / phone status bar) colour. Kept in sync with the header by src/scripts/app.js:
         hero = top of the home page (over the video), light / dark = the solid header in each theme. -->
    <meta name="theme-color" content="#FFFFFF" data-hero="#0B121C" data-light="#FFFFFF" data-dark="#121519" data-home={home ? '1' : '0'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={font} rel="stylesheet" />
    <script is:inline>
      // Theme before first paint (no flash): saved choice → system preference. Adds .js for progressive enhancement.
      (function(){var d=document.documentElement,s;try{s=localStorage.getItem('theme')}catch(e){}
      d.dataset.theme=s||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');d.classList.add('js');
      var m=document.querySelector('meta[name=theme-color]');if(m){var o=m.dataset;m.content=(o.home==='1'&&(window.scrollY||0)<=40)?o.hero:(d.dataset.theme==='dark'?o.dark:o.light)}})();
    </script>
    <script is:inline>
      // Opening splash: plays every time a visitor ENTERS the site (typed address, bookmark, search result, link from another site,
      // the root "/" redirect), and not when they move between pages of the site (e.g. the language switch), nor on back / forward.
      // "Moving between pages" = the referrer is a page of this same site other than "/". Add ?splash to force it (client review).
      // html.spl = overlay on, html.sph = hero entrance held until the panels start to open; the overlay is removed when the last
      // panel finishes (5 s safety net).
      (function(){var d=document.documentElement,on=true;
      try{var r=document.referrer?new URL(document.referrer):null,n=performance.getEntriesByType('navigation')[0];
      if(r&&r.origin===location.origin&&r.pathname!=='/'&&r.pathname!=='/index.html')on=false;
      if(n&&n.type==='back_forward')on=false}catch(e){}
      if(/[?&]splash\b/.test(location.search))on=true;
      if(!on)return;d.classList.add('spl','sph');
      var m=document.querySelector('meta[name=theme-color]');if(m)m.content='#0B121C';
      var rel=function(){d.classList.remove('sph')},end=function(){d.classList.remove('spl','sph');dispatchEvent(new Event('scroll'))};
      document.addEventListener('animationstart',function(e){if(e.animationName==='sp-top')rel()},true);
      document.addEventListener('animationend',function(e){if(e.animationName==='sp-bot')end()},true);
      setTimeout(end,5000)})();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {bc && <script type="application/ld+json" set:html={JSON.stringify(bc)} />}
  </head>
  <body class={home ? 'home' : ''}>
    <div class="splash" id="splash" aria-hidden="true" set:html={splashHtml(lang)} />
    <!-- Logo sprite: defined once per page, referenced by Header and Footer with <use>. Ink follows currentColor, gold follows --logo-gold. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false" set:html={sprite} />
    <Header lang={lang} id={id} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
    <!-- Floating WhatsApp button: fixed at the inline-end corner on every page, number from CONTACT.wa. -->
    <a class="wa-fab" href={`https://wa.me/${CONTACT.wa}`} target="_blank" rel="noopener" aria-label={UI.wa[lang]} title={UI.wa[lang]}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={WA_PATH}/></svg></a>
    <script>import '../scripts/app.js';</script>
  </body>
</html>
